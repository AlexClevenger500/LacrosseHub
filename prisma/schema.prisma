generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(FAN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Core lacrosse models
// ---------------------------------------------------------------------------

model Team {
  id           String      @id @default(cuid())
  name         String
  shortName    String      @unique
  mascot       String?
  conference   String
  division     Division
  gender       Gender
  state        String
  city         String
  logoUrl      String?
  primaryColor String?
  founded      Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  players       Player[]
  homeGames     Game[]           @relation("HomeTeam")
  awayGames     Game[]           @relation("AwayTeam")
  teamGameStats TeamGameStat[]
  recruits      RecruitingCommit[]
  rankings      TeamRanking[]

  @@map("teams")
}

model Player {
  id           String      @id @default(cuid())
  firstName    String
  lastName     String
  number       Int?
  position     Position
  year         AcademicYear
  heightIn     Int?
  weightLbs    Int?
  hometown     String?
  homeState    String?
  teamId       String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  team         Team             @relation(fields: [teamId], references: [id])
  stats        PlayerStat[]
  rankings     PlayerRanking[]

  @@map("players")
}

model Game {
  id           String     @id @default(cuid())
  season       Int
  week         Int?
  gameDate     DateTime
  homeTeamId   String
  awayTeamId   String
  homeScore    Int?
  awayScore    Int?
  status       GameStatus @default(SCHEDULED)
  venue        String?
  attendance   Int?
  isPlayoff    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  homeTeam      Team           @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team           @relation("AwayTeam", fields: [awayTeamId], references: [id])
  playerStats   PlayerStat[]
  teamGameStats TeamGameStat[]

  @@map("games")
}

model PlayerStat {
  id           String   @id @default(cuid())
  playerId     String
  gameId       String
  goals        Int      @default(0)
  assists      Int      @default(0)
  points       Int      @default(0)
  shots        Int      @default(0)
  shotsOnGoal  Int      @default(0)
  groundBalls  Int      @default(0)
  causedTurnovers Int   @default(0)
  turnovers    Int      @default(0)
  faceoffsWon  Int      @default(0)
  faceoffsLost Int      @default(0)
  saves        Int      @default(0)
  goalsAllowed Int      @default(0)
  minutesPlayed Float   @default(0)
  createdAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])
  game   Game   @relation(fields: [gameId], references: [id])

  @@unique([playerId, gameId])
  @@map("player_stats")
}

model TeamGameStat {
  id              String   @id @default(cuid())
  teamId          String
  gameId          String
  goals           Int      @default(0)
  assists         Int      @default(0)
  shots           Int      @default(0)
  shotsOnGoal     Int      @default(0)
  groundBalls     Int      @default(0)
  causedTurnovers Int      @default(0)
  turnovers       Int      @default(0)
  faceoffsWon     Int      @default(0)
  faceoffsTotal   Int      @default(0)
  clearingPct     Float    @default(0)
  emoPossessions  Int      @default(0)
  emoGoals        Int      @default(0)
  saves           Int      @default(0)
  createdAt       DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([teamId, gameId])
  @@map("team_game_stats")
}

model RecruitingCommit {
  id            String          @id @default(cuid())
  firstName     String
  lastName      String
  position      Position
  gradYear      Int
  hometown      String?
  homeState     String?
  teamId        String
  commitDate    DateTime
  stars         Int?
  nationalRank  Int?
  positionRank  Int?
  stateRank     Int?
  status        CommitStatus    @default(COMMITTED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@map("recruiting_commits")
}

model TeamRanking {
  id          String      @id @default(cuid())
  teamId      String
  season      Int
  week        Int
  rank        Int
  prevRank    Int?
  source      String
  wins        Int         @default(0)
  losses      Int         @default(0)
  pointsFor   Int         @default(0)
  pointsAgainst Int       @default(0)
  createdAt   DateTime    @default(now())

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, season, week, source])
  @@map("team_rankings")
}

model PlayerRanking {
  id           String   @id @default(cuid())
  playerId     String
  season       Int
  week         Int
  rank         Int
  prevRank     Int?
  category     String
  source       String
  statValue    Float?
  createdAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, season, week, category, source])
  @@map("player_rankings")
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?
  body        String   @db.Text
  author      String?
  imageUrl    String?
  tags        String[]
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news_articles")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  COACH
  SCOUT
  FAN
}

enum Division {
  DI
  DII
  DIII
  NAIA
  JUCO
}

enum Position {
  ATTACK
  MIDFIELD
  DEFENSE
  GOALIE
  FACEOFF
  LSM
}

enum AcademicYear {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR
  GRADUATE
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  POSTPONED
  CANCELLED
}

enum CommitStatus {
  COMMITTED
  SIGNED
  DECOMMITTED
  ENROLLED
}

enum Gender {
  MENS
  WOMENS
}
